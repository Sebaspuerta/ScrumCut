# Copia este archivo a .env y completa cada valor. Ninguno tiene valor por defecto.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://scrumcut:CAMBIAR@localhost:5432/scrumcut
# Ruta del admin de Django: no obvia, por ejemplo una palabra aleatoria.
ADMIN_URL=
# Solo producción
CSRF_TRUSTED_ORIGINS=https://app.scrumcut.co
HSTS_SECONDS=86400
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
