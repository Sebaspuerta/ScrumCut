                        "pattern": "^-?\\d{0,12}(?:\\.\\d{0,2})?$"
                    },
                    "overdue_count": {
                        "type": "integer"
                    },
                    "overdue_balance": {
                        "type": "string",
                        "format": "decimal",
                        "pattern": "^-?\\d{0,12}(?:\\.\\d{0,2})?$"
